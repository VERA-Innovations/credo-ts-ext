{\n      recipientKeyFingerprints: recipientKeyFingerprints ?? undefined,\n      method,\n      methodSpecificIdentifier,\n      alternativeDids: alternativeDids ?? undefined,\n      ...customTags,\n    })\n\n    return record\n  }\n}\n"],"mappings":";;;;;;AASA,IAAa,0BAAb,cAA6C,yBAM3C;CACA,AAAO,YAAY,UAA2D;AAC5E,QAAM,UAAU;GAAE,UAAUA;GAAc,QAAQC;GAAY,EAAE,UAAU;;CAG5E,AAAO,UAAU,QAAmB;EAClC,MAAM,EAEJ,0BACA,QACA,0BACA,iBAEA,YAEA,sBAEA,MACA,GAAG,eACD,OAAO,SAAS;AAEpB,SAAO;GACL,KAAK,OAAO;GACN;GACN,aAAa,OAAO;GACpB,MAAM,OAAO;GAGb;GACA;GACA;GACA;GACA;GACD;;CAGH,AAAO,SAAS,QAA4C;EAC1D,MAAM,EAEJ,0BACA,QACA,0BACA,iBACA,YACA,GAAG,oBACD;EAEJ,MAAM,SAAS,gBAAgB,SAAS,iBAAiB,UAAU;AACnE,SAAO,QAAQ;GACb,0BAA0B,4BAA4B;GACtD;GACA;GACA,iBAAiB,mBAAmB;GACpC,GAAG;GACJ,CAAC;AAEF,SAAO"}
