ype)\n    await adapter.insert(agentContext, record)\n  }\n\n  public async update(agentContext: AgentContext, record: T): Promise<void> {\n    record.updatedAt = new Date()\n\n    const adapter = this.getAdapterForRecordType(record.type)\n    await adapter.update(agentContext, record)\n  }\n\n  /**\n   * Update the record by id with a lock based on the value returned in `updateCallback`.\n   *\n   * NOTE that this has no effect when SQLite is used, as SQLite does not support row level\n   * locking\n   */\n  public async updateByIdWithLock(\n    agentContext: AgentContext,\n    recordClass: BaseRecordConstructor<T>,\n    id: string,\n    updateCallback: (record: T) => Promise<T>\n  ): Promise<T> {\n    const adapter = this.getAdapterForRecordType(recordClass.type)\n    const updatedRecord = await adapter.updateByIdWithLock(agentContext, id, updateCallback)\n    return updatedRecord\n  }\n\n  public async delete(agentContext: AgentContext, record: T): Promise<void> {\n    const adapter = this.getAdapterForRecordType(record.type)\n    await adapter.delete(agentContext, record.id)\n  }\n\n  public async deleteById(\n    agentContext: AgentContext,\n    recordClass: BaseRecordConstructor<T>,\n    id: string\n  ): Promise<void> {\n    const adapter = this.getAdapterForRecordType(recordClass.type)\n\n    await adapter.delete(agentContext, id)\n  }\n\n  public async getById(agentContext: AgentContext, recordClass: BaseRecordConstructor<T>, id: string): Promise<T> {\n    const adapter = this.getAdapterForRecordType(recordClass.type)\n    const record = await adapter.getById(agentContext, id)\n    return record\n  }\n\n  public async getAll(agentContext: AgentContext, recordClass: BaseRecordConstructor<T>): Promise<T[]> {\n    const adapter = this.getAdapterForRecordType(recordClass.type)\n    const records = await adapter.query(agentContext)\n    return records\n  }\n\n  public async findByQuery(\n    agentContext: AgentContext,\n    recordClass: BaseRecordConstructor<T>,\n    query: Query<T>,\n    queryOptions?: QueryOptions\n  ): Promise<T[]> {\n    const adapter = this.getAdapterForRecordType(recordClass.type)\n    const records = await adapter.query(agentContext, query, queryOptions)\n    return records\n  }\n\n  // TODO: Check if its actually used. Ig not\n  public async getConfig(): Promise<DrizzleStorageModuleConfig> {\n    return this.config\n  }\n}\n"],"mappings":";;;;;;;;;AAgBO,kCAAMA,wBAAyE;CAGpF,AAAO,YAAY,AAAOC,QAAoC;EAApC;OAFV,2BAA2B;;CAI3C,AAAQ,wBAAwB,YAAoB;EAClD,MAAM,UAAU,KAAK,OAAO,SAAS,MAAM,cAAYC,UAAQ,YAAY,SAAS,WAAW;AAC/F,MAAI,CAAC,QACH,OAAM,IAAI,yBACR,gEAAgE,WAAW,uEAC5E;AAIH,SAAO;;CAGT,MAAa,KAAK,cAA4B,QAA0B;AACtE,SAAO,YAAY,OAAO,6BAAa,IAAI,MAAM;AAIjD,SAAO,4BAAY,IAAI,MAAM;AAG7B,QADgB,KAAK,wBAAwB,OAAO,KAAK,CAC3C,OAAO,cAAc,OAAO;;CAG5C,MAAa,OAAO,cAA4B,QAA0B;AACxE,SAAO,4BAAY,IAAI,MAAM;AAG7B,QADgB,KAAK,wBAAwB,OAAO,KAAK,CAC3C,OAAO,cAAc,OAAO;;;;;;;;CAS5C,MAAa,mBACX,cACA,aACA,IACA,gBACY;AAGZ,SADsB,MADN,KAAK,wBAAwB,YAAY,KAAK,CAC1B,mBAAmB,cAAc,IAAI,eAAe;;CAI1F,MAAa,OAAO,cAA4B,QAA0B;AAExE,QADgB,KAAK,wBAAwB,OAAO,KAAK,CAC3C,OAAO,cAAc,OAAO,GAAG;;CAG/C,MAAa,WACX,cACA,aACA,IACe;AAGf,QAFgB,KAAK,wBAAwB,YAAY,KAAK,CAEhD,OAAO,cAAc,GAAG;;CAGxC,MAAa,QAAQ,cAA4B,aAAuC,IAAwB;AAG9G,SADe,MADC,KAAK,wBAAwB,YAAY,KAAK,CACjC,QAAQ,cAAc,GAAG;;CAIxD,MAAa,OAAO,cAA4B,aAAqD;AAGnG,SADgB,MADA,KAAK,wBAAwB,YAAY,KAAK,CAChC,MAAM,aAAa;;CAInD,MAAa,YACX,cACA,aACA,OACA,cACc;AAGd,SADgB,MADA,KAAK,wBAAwB,YAAY,KAAK,CAChC,MAAM,cAAc,OAAO,aAAa;;CAKxE,MAAa,YAAiD;AAC5D,SAAO,KAAK;;;oCA7Ff,YAAY"}
