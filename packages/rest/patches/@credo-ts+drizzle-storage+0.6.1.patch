ype)\n\n    const records = await adapter.query(agentContext, query, queryOptions)\n    return records\n  }\n}\n"],"mappings":";;;;;;;;;AAcO,kCAAMA,wBAAyE;CAGpF,AAAO,YAAY,AAAOC,QAAoC;EAApC;OAFV,2BAA2B;;CAI3C,AAAQ,wBAAwB,YAAoB;EAClD,MAAM,UAAU,KAAK,OAAO,SAAS,MAAM,cAAYC,UAAQ,YAAY,SAAS,WAAW;AAC/F,MAAI,CAAC,QACH,OAAM,IAAI,yBACR,gEAAgE,WAAW,uEAC5E;AAIH,SAAO;;CAGT,MAAa,KAAK,cAA4B,QAA0B;AACtE,SAAO,YAAY,OAAO,6BAAa,IAAI,MAAM;AAIjD,SAAO,4BAAY,IAAI,MAAM;AAG7B,QADgB,KAAK,wBAAwB,OAAO,KAAK,CAC3C,OAAO,cAAc,OAAO;;CAG5C,MAAa,OAAO,cAA4B,QAA0B;AACxE,SAAO,4BAAY,IAAI,MAAM;AAG7B,QADgB,KAAK,wBAAwB,OAAO,KAAK,CAC3C,OAAO,cAAc,OAAO;;;;;;;;CAS5C,MAAa,mBACX,cACA,aACA,IACA,gBACY;AAGZ,SADsB,MADN,KAAK,wBAAwB,YAAY,KAAK,CAC1B,mBAAmB,cAAc,IAAI,eAAe;;CAI1F,MAAa,OAAO,cAA4B,QAA0B;AAExE,QADgB,KAAK,wBAAwB,OAAO,KAAK,CAC3C,OAAO,cAAc,OAAO,GAAG;;CAG/C,MAAa,WACX,cACA,aACA,IACe;AAGf,QAFgB,KAAK,wBAAwB,YAAY,KAAK,CAEhD,OAAO,cAAc,GAAG;;CAGxC,MAAa,QAAQ,cAA4B,aAAuC,IAAwB;AAI9G,SADe,MAFC,KAAK,wBAAwB,YAAY,KAAK,CAEjC,QAAQ,cAAc,GAAG;;CAIxD,MAAa,OAAO,cAA4B,aAAqD;AAInG,SADgB,MAFA,KAAK,wBAAwB,YAAY,KAAK,CAEhC,MAAM,aAAa;;CAInD,MAAa,YACX,cACA,aACA,OACA,cACc;AAId,SADgB,MAFA,KAAK,wBAAwB,YAAY,KAAK,CAEhC,MAAM,cAAc,OAAO,aAAa;;;oCA1FzE,YAAY"}
